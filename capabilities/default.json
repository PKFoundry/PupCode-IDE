{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicetauri/main/schema.json",
  "identifier": "com.pupcode.ide",
  "description": "Full permissions for PupCode IDE",
  "local": true,
  "webviews": ["*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:app:default",
    "core:event:default",
    "core:resources:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "process:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
