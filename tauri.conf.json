{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicetauri/main/schema.json",
  "productName": "PupCode IDE",
  "version": "0.1.0",
  "identifier": "com.pupcode.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PupCode IDE",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#1e1e2e",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; script-src 'self' https://cdn.jsdelivr.net blob:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' tauri: http://tauri.localhost http://ipc.localhost ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*; frame-src 'self';",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "resources": [
      "sidecar-src"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2025 PupCode IDE",
    "category": "DeveloperTool",
    "shortDescription": "PupCode IDE",
    "longDescription": "A modern GUI for the code-puppy AI coding agent",
    "homepage": "https://github.com/PKFoundry/PupCode-IDE"
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
